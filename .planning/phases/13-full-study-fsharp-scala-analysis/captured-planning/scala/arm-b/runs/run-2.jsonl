 def parseTerm: Int = {\\n      var result = parseFactor\\n      while (current == Star || current == Slash) {\\n        val op = current\\n        idx += 1\\n        val right = parseFactor\\n        result = op match {\\n          case Star => result * right\\n          case Slash =>\\n            if (right == 0) throw new ArithmeticException(\\\"Division by zero\\\")\\n            result / right\\n        }\\n      }\\n      result\\n    }\\n\\n    // factor = Num | '(' expr ')'\\n    def parseFactor: Int = {\\n      current match {\\n        case Num(v) => idx += 1; v\\n        case LParen =>\\n          idx += 1\\n          val result = parseExpr\\n          consume(RParen)\\n          result\\n        case Eof => throw new IllegalArgumentException(\\\"Unexpected end of input\\\")\\n        case _ => throw new IllegalArgumentException(s\\\"Unexpected token: $current\\\")\\n      }\\n    }\\n\\n    def parse: Int = {\\n      val result = parseExpr\\n      if (current != Eof)\\n        throw new IllegalArgumentException(s\\\"Unexpected token after expression: $current\\\")\\n      result\\n    }\\n  }\\n\\n  // --- Main ---\\n  def main(args: Array[String]): Unit = {\\n    if (args.length != 1) {\\n      System.err.println(\\\"Usage: scala-cli run Calc.scala -- \\\\\\\"<expression>\\\\\\\"\\\")\\n      System.exit(1)\\n    }\\n    val expression = args(0)\\n    val tokens = tokenize(expression)\\n    val parser = new Parser(tokens)\\n    val result = parser.parse\\n    println(result)\\n  }\\n}\\n```\\n\\nPlease use the file_editor tool with command=\\\"create\\\" or command=\\\"str_replace\\\" to write this file.\", \"subagent_type\": \"general-purpose\"}", "kind": "ActionEvent"}
