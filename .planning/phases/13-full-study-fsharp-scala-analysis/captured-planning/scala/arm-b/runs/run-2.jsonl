er[Token]()\n    var i = 0\n    while (i < chars.length) {\n      val c = chars(i)\n      if (c.isWhitespace) {\n        i += 1\n      } else if (c == '+') {\n        tokens += Plus; i += 1\n      } else if (c == '-') {\n        tokens += Minus; i += 1\n      } else if (c == '*') {\n        tokens += Star; i += 1\n      } else if (c == '/') {\n        tokens += Slash; i += 1\n      } else if (c == '(') {\n        tokens += LParen; i += 1\n      } else if (c == ')') {\n        tokens += RParen; i += 1\n      } else if (c.isDigit) {\n        val start = i\n        while (i < chars.length && chars(i).isDigit) i += 1\n        val numStr = new String(chars, start, i - start)\n        tokens += Num(numStr.toInt)\n      } else {\n        throw new IllegalArgumentException(s\"Unexpected character: '$c'\")\n      }\n    }\n    tokens.toList\n  }\n\n  // --- Parser (recursive descent) ---\n  class Parser(tokens: List[Token]) {\n    private var idx = 0\n\n    private def current: Token =\n      if (idx < tokens.length) tokens(idx) else Eof\n\n    private def consume(expected: Token): Token = {\n      val t = current\n      if (t != expected)\n        throw new IllegalArgumentException(s\"Expected $expected but got $t\")\n      idx += 1\n      t\n    }\n\n    // expr = term ((+|-) term)*\n    def parseExpr: Int = {\n      var result = parseTerm\n      while (current == Plus || current == Minus) {\n        val op = current\n        idx += 1\n        val right = parseTerm\n        result = op match {\n          case Plus  => result + right\n          case Minus => result - right\n        }\n      }\n      result\n    }\n\n    // term = factor ((*|/) factor)*\n    def parseTerm: Int = {\n      var result = parseFactor\n      while (current == Star || current == Slash) {\n        val op = current\n        idx += 1\n        val right = parseFactor\n        result = op match {\n          case Star => result * right\n          case Slash =>\n            if (right == 0) throw new Arith