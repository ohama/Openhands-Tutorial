%{
// Parser for integer arithmetic expressions
// Grammar:
//   expr -> term ((+|-) term)*
//   term -> factor ((*|/) factor)*
//   factor -> NUMBER | ( expr )
%}

%token PLUS MINUS MULT DIV LPAREN RPAREN NUMBER EOF
%left PLUS MINUS
%left MULT DIV
%start main
%type <int> main

%%

main:
    | expr = expr; EOF { expr }

expr:
    | e1 = expr; PLUS; e2 = expr { e1 + e2 }
    | e1 = expr; MINUS; e2 = expr { e1 - e2 }
    | t = term { t }

term:
    | t1 = term; MULT; t2 = term { t1 * t2 }
    | t1 = term; DIV; t2 = term { t1 / t2 }
    | f = factor { f }

factor:
    | n = NUMBER { n }
    | LPAREN; e = expr; RPAREN { e }
