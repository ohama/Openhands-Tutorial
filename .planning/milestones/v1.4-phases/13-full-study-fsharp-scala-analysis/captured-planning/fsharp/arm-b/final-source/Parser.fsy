%{
module Parser

open System
open Lexer
%}

%token <int> INT
%token PLUS
%token MINUS
%token TIMES
%token DIVIDE
%token LPAREN
%token RPAREN
%token EOF

%left PLUS MINUS
%left TIMES DIVIDE

%start expr
%type expr : int

%%

expr:
  | expr PLUS expr    { $1 + $3 }
  | expr MINUS expr   { $1 - $3 }
  | expr TIMES expr   { $1 * $3 }
  | expr DIVIDE expr  { $1 / $3 }
  | INT               { $1 }
  | LPAREN expr RPAREN { $2 }
  | MINUS expr        { -$2 }
