{
// Lexer generated by FsLex
// Recognizes integer literals and arithmetic operators: + - * / ( )
}

macro whitespace = [' ' '\t' '\r' '\n']
macro digit = ['0'-'9']

rule tokenize = parse
  | whitespace+    { tokenize lexbuf }
  | '+'            { Token.PLUS }
  | '-'            { Token.MINUS }
  | '*'            { Token.MULT }
  | '/'            { Token.DIV }
  | '('            { Token.LPAREN }
  | ')'            { Token.RPAREN }
  | digit+         { Token.NUMBER (int_of_string (lexeme lexbuf)) }
  | eof            { Token.EOF }
